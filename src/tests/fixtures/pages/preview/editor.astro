---
import { Marketplace } from "../../../../storefront/marketplace";
import { styleKeys } from "../../../../storefront/widget-style";
import { readFilterVisibility } from "../../../../storefront/filter-visibility";
import { isLocalDemo } from "../../../../backend/context";
if (!isLocalDemo())
  return new Response("Local demo is disabled.", { status: 404 });
const widgetStyle = Object.fromEntries(
  styleKeys.map((key) => [key, Astro.url.searchParams.get(key) ?? ""]),
);
const filterVisibility = readFilterVisibility((key) =>
  Astro.url.searchParams.get(key),
);
const limit = Number(Astro.url.searchParams.get("limit")) || 12;
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="robots" content="noindex,nofollow" />
    <title>Vehicle widget resize fixture</title>
    <style>
      body {
        margin: 0;
        background: #f4f6f1;
        font-family: system-ui;
      }
      main {
        margin: 24px;
        max-width: 1200px;
      }
      #fixture {
        width: 100%;
        background: white;
      }
      p {
        line-height: 1.6;
      }
    </style>
  </head>
  <body>
    <main>
      <h1>Widget preview</h1>
      <p>Editor design preview. Demo listings stay private.</p>
      <div id="fixture">
        <Marketplace
          designMode
          widgetStyle={widgetStyle}
          filterVisibility={filterVisibility}
          limit={limit}
          client:load
        />
      </div>
    </main>
  </body>
</html>
